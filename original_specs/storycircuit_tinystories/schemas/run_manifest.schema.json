{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiologic.net/storycircuit/schemas/run_manifest.schema.json",
  "title": "Evaluation run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "model", "suite", "environment", "status"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "model": {"type": "object"},
    "suite": {"type": "object"},
    "environment": {"type": "object"},
    "status": {"enum": ["running", "complete", "failed", "partial"]},
    "metrics_path": {"type": ["string", "null"]},
    "predictions_path": {"type": ["string", "null"]},
    "errors_path": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
