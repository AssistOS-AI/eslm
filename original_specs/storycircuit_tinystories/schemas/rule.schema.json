{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiologic.net/storycircuit/schemas/rule.schema.json",
  "title": "Executable narrative rule",
  "type": "object",
  "required": ["id", "kind", "variables", "body", "head", "semantics", "statistics", "provenance"],
  "properties": {
    "id": {"type": "string"},
    "kind": {"enum": ["state_effect", "inference", "default", "prediction", "causal", "schema_constraint"]},
    "variables": {"type": "array", "items": {"type": "object", "required": ["name", "type"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}}, "additionalProperties": false}},
    "body": {"type": "array", "items": {"type": "object"}},
    "head": {"type": "array", "items": {"type": "object"}},
    "semantics": {"enum": ["deterministic", "defeasible", "probabilistic"]},
    "priority": {"type": "integer"},
    "statistics": {
      "type": "object",
      "required": ["support", "counterexamples", "confidence"],
      "properties": {
        "support": {"type": "integer", "minimum": 0},
        "counterexamples": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "dev_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "dev_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "array", "items": {"type": "object"}},
    "regime": {"enum": ["S0", "S1", "S2"]}
  },
  "additionalProperties": false
}
