{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiologic.net/storycircuit/schemas/story_ir.schema.json",
  "title": "StoryIR",
  "type": "object",
  "required": ["schema_version", "document", "entities", "mentions", "propositions", "events", "relations", "diagnostics"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "document": {
      "type": "object",
      "required": ["id", "text", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "mentions": {"type": "array", "items": {"$ref": "#/$defs/mention"}},
    "propositions": {"type": "array", "items": {"$ref": "#/$defs/proposition"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "ambiguities": {"type": "array", "items": {"type": "object"}, "default": []},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^e[0-9]+$"},
        "type": {"type": "string"},
        "name": {"type": ["string", "null"]},
        "attributes": {"type": "object"},
        "introduced_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "mention": {
      "type": "object",
      "required": ["id", "span", "surface", "referent", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^m[0-9]+$"},
        "span": {"$ref": "#/$defs/span"},
        "surface": {"type": "string"},
        "referent": {"type": ["string", "null"]},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["resolved", "ambiguous", "unresolved"]}
      },
      "additionalProperties": false
    },
    "argument": {
      "type": "object",
      "required": ["role", "value"],
      "properties": {
        "role": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]}
      },
      "additionalProperties": false
    },
    "proposition": {
      "type": "object",
      "required": ["id", "predicate", "arguments", "polarity", "status", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^p[0-9]+$"},
        "predicate": {"type": "string"},
        "arguments": {"type": "array", "items": {"$ref": "#/$defs/argument"}},
        "polarity": {"enum": ["positive", "negative"]},
        "status": {"enum": ["asserted", "entailed", "defeasible", "hypothesized", "ambiguous", "contradicted", "retracted", "unknown"]},
        "modality": {"type": ["string", "null"]},
        "holder": {"type": ["string", "null"]},
        "time": {"type": ["string", "null"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "participants", "polarity", "status", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^v[0-9]+$"},
        "type": {"type": "string"},
        "participants": {"type": "array", "items": {"$ref": "#/$defs/argument"}},
        "polarity": {"enum": ["positive", "negative"]},
        "status": {"enum": ["asserted", "entailed", "defeasible", "hypothesized", "ambiguous", "contradicted", "retracted", "unknown"]},
        "tense": {"type": ["string", "null"]},
        "aspect": {"type": ["string", "null"]},
        "time": {"type": ["string", "null"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": ["id", "type", "source", "target", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^r[0-9]+$"},
        "type": {"enum": ["before", "after", "overlaps", "causes", "enables", "prevents", "supports", "contradicts", "elaborates", "goal_of", "knows", "believes", "wants", "other"]},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "status": {"enum": ["asserted", "entailed", "defeasible", "hypothesized", "ambiguous"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string"},
        "span": {"oneOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
