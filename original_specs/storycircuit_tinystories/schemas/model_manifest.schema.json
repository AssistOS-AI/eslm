{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiologic.net/storycircuit/schemas/model_manifest.schema.json",
  "title": "ESLM model manifest",
  "type": "object",
  "required": ["schema_version", "model_id", "version", "regime", "created_at", "source", "data", "configuration", "components", "complexity", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "model_id": {"type": "string"},
    "version": {"type": "string"},
    "regime": {"enum": ["S0", "S1", "S2"]},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {"type": "object", "required": ["commit", "dirty"], "properties": {"commit": {"type": "string"}, "dirty": {"type": "boolean"}}, "additionalProperties": true},
    "data": {"type": "object", "required": ["manifests"], "properties": {"manifests": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true},
    "configuration": {"type": "object", "required": ["sha256", "resolved"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "resolved": {"type": "object"}}, "additionalProperties": false},
    "components": {"type": "array", "items": {"type": "object", "required": ["id", "path", "sha256"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "format": {"type": "string"}}, "additionalProperties": true}},
    "complexity": {"type": "object", "required": ["numeric_parameters", "symbolic_records", "artifact_bytes"], "properties": {"numeric_parameters": {"type": "integer", "minimum": 0}, "symbolic_records": {"type": "integer", "minimum": 0}, "ast_nodes": {"type": "integer", "minimum": 0}, "artifact_bytes": {"type": "integer", "minimum": 0}, "description_length_bits": {"type": ["number", "null"], "minimum": 0}}, "additionalProperties": true},
    "teacher_usage": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
